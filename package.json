{
  "name": "@tty-pt/axil-tty",
  "version": "1.3.0",
  "description": "AXIL PTY multiplexer module",
  "main": "cjs/axil-tty.js",
  "browser": "htdocs/axil-tty.js",
  "types": "types/axil-tty.d.ts",
  "module": "esm/axil-tty.js",
  "entry": {
    "main": "./axil-tty.js",
    "demo": "./demo.js"
  },
  "template": "index.html",
  "library": "ttyAxil",
  "exports": {
    ".": {
      "types": "./types/axil-tty.d.ts",
      "import": "./axil-tty.js",
      "default": "./cjs/axil-tty.js"
    },
    "./axil-tty.css": "./htdocs/axil-tty.css"
  },
  "external": {
    "lodash": "global lodash",
    "@xterm/addon-fit": "global FitAddon",
    "@xterm/addon-web-links": "global WebLinksAddon",
    "@xterm/xterm": "global Terminal"
  },
  "directories": {
    "doc": "docs"
  },
  "bin": {
    "axil": "./axil-tty-cli.js"
  },
  "scripts": {
    "build": "scripts build",
    "postinstall": "make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/axil-tty.git"
  },
  "author": "quirinpa",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/tty-pt/axil-tty/issues"
  },
  "homepage": "https://tty.pt",
  "devDependencies": {
    "@tty-pt/scripts": "^0.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lodash": "^4.17.21"
  },
  "keywords": [
    "axil",
    "terminal",
    "tty",
    "WebSocket",
    "WebSockets",
    "ws",
    "session",
    "mux",
    "multiplexer"
  ],
  "serve": [
    "art"
  ],
  "files": [
    "axil-tty.css",
    "htdocs",
    ".index",
    "cjs",
    "esm",
    "src/*.c",
    "axil-tty.js",
    "axil-tty-cli.js",
    "types",
    "include",
    "Makefile"
  ]
}
